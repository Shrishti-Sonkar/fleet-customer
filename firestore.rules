rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isLoggedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isLoggedIn() && userDoc().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isVendor() {
      // `owner` is the legacy name used by older accounts and is treated as
      // vendor throughout the application.
      return hasRole('vendor') || hasRole('owner');
    }

    function userCreateFields() {
      return [
        'uid', 'name', 'email', 'phone', 'role', 'roleSetAt',
        'kycStatus', 'isVerified', 'verifiedBadge',
        'tokens', 'tokensUsed', 'vendorRequested', 'vendorRequestedAt',
        'createdAt', 'updatedAt'
      ];
    }

    function safeUserUpdateFields() {
      return [
        'name', 'displayName', 'phone', 'photoURL', 'dob', 'gender', 'bio',
        'captainMode', 'payout', 'razorpayAccountId',
        'role', 'roleSetAt',
        'vendorRequested', 'vendorRequestedAt',
        'kycStatus', 'aadhaarUrl', 'dlUrl', 'selfieUrl',
        'emergencyContact',
        'fcmTokens',
        'updatedAt'
      ];
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function roleIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        || (
          (resource.data.role == 'vendor' && request.resource.data.role == 'renter')
          || (resource.data.role == 'owner' && request.resource.data.role == 'vendor')
        );
    }

    function kycStatusIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kycStatus'])
        || (
          resource.data.kycStatus in ['not_submitted', 'pending', 'rejected']
          && request.resource.data.kycStatus in ['not_submitted', 'pending']
        );
    }

    function trustedAssetUrl(url) {
      return url.startsWith('https://res.cloudinary.com/')
        || url.startsWith('https://firebasestorage.googleapis.com/')
        || url.startsWith('https://storage.googleapis.com/');
    }

    function urlFieldsAreSafe() {
      return (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aadhaarUrl'])
        || trustedAssetUrl(request.resource.data.aadhaarUrl)
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dlUrl'])
        || trustedAssetUrl(request.resource.data.dlUrl)
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['selfieUrl'])
        || trustedAssetUrl(request.resource.data.selfieUrl)
      );
    }

    function verificationUrlsAreSafe() {
      return trustedAssetUrl(request.resource.data.aadhaarUrl)
        && trustedAssetUrl(request.resource.data.dlUrl)
        && trustedAssetUrl(request.resource.data.selfieUrl);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(userCreateFields())
        && (!('role' in request.resource.data) || request.resource.data.role == 'renter')
        && (!('kycStatus' in request.resource.data) || request.resource.data.kycStatus in ['not_submitted', 'pending']);
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && changedOnly(safeUserUpdateFields())
          && roleIsSafe()
          && kycStatusIsSafe()
          && urlFieldsAreSafe()
        );
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /vehicles/{vehicleId} {
      // Vehicle documents are listing data, but still require authentication
      // until a separate publicVehicles projection is introduced.
      allow read: if isLoggedIn();
      allow create: if isVendor()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'name', 'type', 'brand', 'model', 'year', 'fuelType', 'seats',
          'city', 'useCase', 'description', 'regNo', 'category', 'cc',
          'mileage', 'dailyPrice', 'weeklyPrice', 'pricePerHour',
          'pricePerMonth', 'securityDeposit', 'imageUrl', 'images',
          'ownerId', 'ownerName', 'hostName', 'hostRating', 'hostReviews',
          'features', 'status', 'available', 'rating', 'reviewCount',
          'badge', 'createdAt', 'updatedAt'
        ]);
      allow update: if isAdmin()
        || (
          isVendor()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == resource.data.status
          && changedOnly(['available', 'updatedAt'])
        );
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isLoggedIn() && (
        resource.data.renterId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /verificationRequests/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'email', 'phone', 'aadhaarUrl', 'dlUrl',
          'selfieUrl', 'status', 'submittedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && verificationUrlsAreSafe();
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'userId', 'userName', 'email', 'phone', 'aadhaarUrl', 'dlUrl',
            'selfieUrl', 'status', 'submittedAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && verificationUrlsAreSafe()
        );
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Reviews are written by the backend (admin SDK) via /api/bookings/:id/review,
      // which verifies the booking is completed and owned by the renter.
      allow create, update, delete: if false;
    }

    match /wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /notifications/{notifId} {
      allow read: if isLoggedIn() && resource.data.userId == request.auth.uid;
      allow update: if isLoggedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isLoggedIn() && resource.data.userId == request.auth.uid;
      // Notifications are created by the trusted API/Admin SDK only.
      allow create: if false;
    }

    match /coupons/{couponId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isLoggedIn()
        && request.resource.data.renterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /reportActions/{actionId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }
  }
}
