{
  "name": "fleet-rental",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"nodemon --watch server.js --watch api --watch .env --ext js,mjs,cjs,json server.js\"",
    "build": "vite build",
    "start": "node server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/rules/firestore.rules.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules/firestore.rules.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^4.3.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "razorpay": "^2.9.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-dropzone": "^15.0.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "^15.25.1",
    "globals": "^17.6.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.16"
  }
}
