{
  "family": "fleet-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "REPLACE_WITH_ECS_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_WITH_ECS_TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "fleet-api",
      "image": "REPLACE_WITH_ECR_IMAGE",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "5000" }
      ],
      "secrets": [
        { "name": "FIREBASE_SERVICE_ACCOUNT_BASE64", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:FIREBASE_SERVICE_ACCOUNT_BASE64::" },
        { "name": "RAZORPAY_KEY_ID", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:RAZORPAY_KEY_ID::" },
        { "name": "RAZORPAY_KEY_SECRET", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:RAZORPAY_KEY_SECRET::" },
        { "name": "CLOUDINARY_CLOUD_NAME", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:CLOUDINARY_CLOUD_NAME::" },
        { "name": "CLOUDINARY_API_KEY", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:CLOUDINARY_API_KEY::" },
        { "name": "CLOUDINARY_API_SECRET", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:CLOUDINARY_API_SECRET::" },
        { "name": "CORS_ORIGINS", "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_ARN:CORS_ORIGINS::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:5000/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fleet-api",
          "awslogs-region": "REPLACE_WITH_AWS_REGION",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
